{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/buchochelliq-labs/dbt-skills/schemas/modelling-policy-v1",
  "title": "dbt-skills modelling documents v1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "policy"
        },
        "tokens": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "maxProperties": 256,
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "naming": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "\\S"
              },
              "target": {
                "enum": [
                  "model_id",
                  "model_file",
                  "directory",
                  "warehouse_alias",
                  "column",
                  "properties_file"
                ]
              },
              "template": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "\\S"
              },
              "scope": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "pattern": "\\S"
                },
                "maxProperties": 256,
                "propertyNames": {
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                }
              },
              "bindings": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "pattern": "\\S"
                },
                "maxProperties": 256,
                "propertyNames": {
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                }
              }
            },
            "required": [
              "id",
              "target",
              "template"
            ],
            "additionalProperties": false
          },
          "maxItems": 256
        },
        "modelling": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "\\S"
              },
              "scope": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "pattern": "\\S"
                },
                "maxProperties": 256,
                "propertyNames": {
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                }
              },
              "style": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "\\S"
              },
              "normal_form": {
                "enum": [
                  "unspecified",
                  "none",
                  "1NF",
                  "2NF",
                  "3NF",
                  "BCNF",
                  "4NF",
                  "5NF"
                ]
              },
              "principles": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "pattern": "\\S"
                },
                "maxItems": 256
              }
            },
            "required": [
              "id",
              "style",
              "normal_form"
            ],
            "additionalProperties": false
          },
          "maxItems": 256
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "maxItems": 256
        }
      },
      "required": [
        "schema_version",
        "kind",
        "tokens",
        "naming",
        "modelling"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "observations"
        },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "\\S"
              },
              "statement": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "\\S"
              },
              "confidence": {
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "document": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "pattern": "\\S"
                    },
                    "revision": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "pattern": "\\S"
                    },
                    "locator": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "pattern": "\\S"
                    }
                  },
                  "required": [
                    "document",
                    "revision",
                    "locator"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 256,
                "minItems": 1
              },
              "counterexamples": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "document": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "pattern": "\\S"
                    },
                    "revision": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "pattern": "\\S"
                    },
                    "locator": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "pattern": "\\S"
                    }
                  },
                  "required": [
                    "document",
                    "revision",
                    "locator"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 256
              }
            },
            "required": [
              "id",
              "statement",
              "confidence",
              "evidence"
            ],
            "additionalProperties": false
          },
          "maxItems": 256
        }
      },
      "required": [
        "schema_version",
        "kind",
        "records"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "decisions"
        },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "\\S"
              },
              "rule_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "\\S"
              },
              "decision": {
                "enum": [
                  "exception",
                  "standard_change"
                ]
              },
              "models": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "pattern": "\\S"
                },
                "maxItems": 256
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "\\S"
              },
              "approved_by": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "\\S"
              },
              "approved_at": {
                "type": "string",
                "format": "date-time"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "document": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "pattern": "\\S"
                    },
                    "revision": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "pattern": "\\S"
                    },
                    "locator": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "pattern": "\\S"
                    }
                  },
                  "required": [
                    "document",
                    "revision",
                    "locator"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 256,
                "minItems": 1
              }
            },
            "required": [
              "id",
              "rule_id",
              "decision",
              "models",
              "rationale",
              "approved_by",
              "approved_at",
              "evidence"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "decision": {
                      "const": "exception"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "models": {
                      "minItems": 1
                    }
                  }
                }
              }
            ]
          },
          "maxItems": 256
        }
      },
      "required": [
        "schema_version",
        "kind",
        "records"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "proposals"
        },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "\\S"
              },
              "rule_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "\\S"
              },
              "decision": {
                "enum": [
                  "exception",
                  "standard_change"
                ]
              },
              "models": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "pattern": "\\S"
                },
                "maxItems": 256
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "\\S"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "document": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "pattern": "\\S"
                    },
                    "revision": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "pattern": "\\S"
                    },
                    "locator": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "pattern": "\\S"
                    },
                    "generated_at": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "pattern": "\\S"
                    },
                    "observed_at": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "pattern": "\\S"
                    }
                  },
                  "required": [
                    "document",
                    "revision",
                    "locator"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 256,
                "minItems": 1
              },
              "trigger_model": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "\\S"
              },
              "observed_path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "\\S"
              },
              "previous_template": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "\\S"
              },
              "proposed_template": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "\\S"
              },
              "rule_scope": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "pattern": "\\S"
                },
                "maxProperties": 256,
                "propertyNames": {
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                }
              }
            },
            "required": [
              "id",
              "rule_id",
              "decision",
              "models",
              "rationale",
              "evidence",
              "trigger_model",
              "observed_path",
              "previous_template",
              "rule_scope"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "decision": {
                      "const": "exception"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "models": {
                      "minItems": 1,
                      "maxItems": 1
                    }
                  },
                  "not": {
                    "required": [
                      "proposed_template"
                    ]
                  }
                },
                "else": {
                  "required": [
                    "proposed_template"
                  ],
                  "properties": {
                    "models": {
                      "maxItems": 0
                    }
                  }
                }
              }
            ]
          },
          "maxItems": 256
        }
      },
      "required": [
        "schema_version",
        "kind",
        "records"
      ],
      "additionalProperties": false
    }
  ]
}
