{
  "mcpServers": {
    "dbt-modelling": {
      "command": "/absolute/path/to/python",
      "args": [
        "-m",
        "dbt_skills.modelling_mcp",
        "--project-dir",
        "/absolute/path/to/dbt-project",
        "--policy",
        "modelling.yml"
      ],
      "env": {
        "PYTHONPATH": "/absolute/path/to/dbt-skills/src"
      }
    }
  }
}
